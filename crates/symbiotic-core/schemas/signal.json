{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signal",
  "description": "One classified message.",
  "type": "object",
  "properties": {
    "confidence": {
      "description": "Classifier confidence, from 0 to 1.",
      "type": "number",
      "format": "double"
    },
    "id": {
      "$ref": "#/$defs/SignalId"
    },
    "kind": {
      "$ref": "#/$defs/SignalKind"
    },
    "observedAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "quoted": {
      "description": "The words that carry the signal, quoted exactly; never the whole message.",
      "type": "string"
    },
    "session": {
      "description": "The session the message belongs to.",
      "type": "string"
    },
    "turn": {
      "description": "Zero-based turn index within the session.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "observedAt",
    "kind",
    "quoted",
    "session",
    "turn",
    "confidence"
  ],
  "$defs": {
    "SignalId": {
      "description": "Classifier-assigned signal identifier; a repeated id is the same signal.",
      "type": "string"
    },
    "SignalKind": {
      "description": "What a message carries.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "correction",
            "preference",
            "problem",
            "operator_blocker",
            "none"
          ]
        },
        {
          "description": "The agent misread the operator.",
          "type": "string",
          "const": "confusion"
        },
        {
          "description": "The operator's words leave two readings.",
          "type": "string",
          "const": "clarification"
        }
      ]
    },
    "Timestamp": {
      "description": "ISO 8601 UTC timestamp as the source wrote it, for example\n`2026-10-31T20:56:19Z`. Contract types carry it unparsed, so it has no\nordering: string order is not time order when precision differs.",
      "type": "string"
    }
  }
}
