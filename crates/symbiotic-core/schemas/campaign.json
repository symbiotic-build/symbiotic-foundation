{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Campaign",
  "description": "A goal and its plan.",
  "type": "object",
  "properties": {
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Constraint"
      }
    },
    "decisions": {
      "description": "Recorded deviations from instructions, oldest first.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/DecisionRecord"
      }
    },
    "goal": {
      "type": "string"
    },
    "id": {
      "$ref": "#/$defs/CampaignId"
    },
    "instructions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Instruction"
      }
    },
    "policies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Policy"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "goal",
    "instructions",
    "constraints",
    "decisions",
    "policies"
  ],
  "$defs": {
    "CampaignId": {
      "description": "Stable campaign identifier.",
      "type": "string"
    },
    "Constraint": {
      "description": "A checkable rule derived from one instruction.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "instructionId": {
          "type": "string"
        },
        "rule": {
          "$ref": "#/$defs/ConstraintRule"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "instructionId",
        "rule"
      ]
    },
    "ConstraintRule": {
      "description": "The kinds of campaign constraint.",
      "oneOf": [
        {
          "description": "Every step in `first` finishes before any step in `then` starts; an\nempty `then` means every other step.",
          "type": "object",
          "properties": {
            "first": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "ordering"
            },
            "then": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "first",
            "then"
          ]
        },
        {
          "description": "A setting never goes below `value`, for example concurrency 16.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "minimum"
            },
            "setting": {
              "type": "string"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "setting",
            "value"
          ]
        },
        {
          "description": "A field every report must carry.",
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "required_report_field"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "field"
          ]
        },
        {
          "description": "Spend ceiling in US dollars, for one provider or for all when absent.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "spend_limit"
            },
            "limitUsd": {
              "type": "number",
              "format": "double"
            },
            "period": {
              "$ref": "#/$defs/SpendPeriod"
            },
            "provider": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "period",
            "limitUsd"
          ]
        },
        {
          "description": "A build rule compiled into worker briefs, for example `--release`.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "build_rule"
            },
            "rule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "rule"
          ]
        }
      ]
    },
    "DecisionRecord": {
      "description": "A recorded deviation: the instruction quoted, what changes, and why.",
      "type": "object",
      "properties": {
        "change": {
          "type": "string"
        },
        "decidedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "instructionId": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "quote",
        "change",
        "reason",
        "decidedAt"
      ]
    },
    "DetailValue": {
      "description": "A detail value: a number or an enumeration token, never free text.",
      "anyOf": [
        {
          "type": "integer",
          "format": "int64"
        },
        {
          "type": "number",
          "format": "double"
        },
        {
          "$ref": "#/$defs/EnumToken"
        }
      ]
    },
    "EnumToken": {
      "description": "An enumeration value, never free text.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
    },
    "EventKind": {
      "description": "Dotted event kind, subject first: `provider.refused`, `job.failed`.",
      "type": "string"
    },
    "Instruction": {
      "description": "One operator instruction, quoted exactly.",
      "type": "object",
      "properties": {
        "givenAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "quote": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "quote"
      ]
    },
    "Policy": {
      "description": "Maps matching events, past a threshold, to actions run in order.",
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyAction"
          }
        },
        "name": {
          "type": "string"
        },
        "threshold": {
          "$ref": "#/$defs/Threshold"
        },
        "trigger": {
          "$ref": "#/$defs/TriggerPattern"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "trigger",
        "threshold",
        "actions"
      ]
    },
    "PolicyAction": {
      "description": "One policy action. Fieldless actions are empty struct variants because\nserde ignores extra fields on unit variants of a tagged enum.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "record"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "notify"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Raise a decision of this kind.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ask"
            },
            "questionKind": {
              "$ref": "#/$defs/QuestionKind"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "questionKind"
          ]
        },
        {
          "description": "Move to the campaign's next ready step that the event does not block.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "divert"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "Set the remaining matching steps aside with the reason.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "shelve"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "QuestionKind": {
      "description": "Why a question needs a person.",
      "type": "string",
      "enum": [
        "authority",
        "ambiguity",
        "preference",
        "contradiction",
        "blocker"
      ]
    },
    "SpendPeriod": {
      "description": "The period a spend limit covers.",
      "type": "string",
      "enum": [
        "day",
        "run"
      ]
    },
    "Threshold": {
      "description": "When matching events fire a policy.",
      "oneOf": [
        {
          "description": "`count` matches, counted per distinct value of the `group_by` subject keys.",
          "type": "object",
          "properties": {
            "consecutive": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "groupBy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "count"
            },
            "withinMinutes": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "count",
            "consecutive",
            "groupBy"
          ]
        },
        {
          "description": "No matching event for `minutes` while the run is active.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "silence"
            },
            "minutes": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "minutes"
          ]
        },
        {
          "description": "A matching state lasts `minutes`, for example a session left waiting.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "age"
            },
            "minutes": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "minutes"
          ]
        }
      ]
    },
    "Timestamp": {
      "description": "ISO 8601 UTC timestamp as the source wrote it, for example\n`2026-10-31T20:56:19Z`. Contract types carry it unparsed, so it has no\nordering: string order is not time order when precision differs.",
      "type": "string"
    },
    "TriggerPattern": {
      "description": "Matches events of one kind whose subject and detail contain every listed\nentry with an equal value.",
      "type": "object",
      "properties": {
        "detail": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/DetailValue"
          }
        },
        "eventKind": {
          "$ref": "#/$defs/EventKind"
        },
        "subject": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "eventKind",
        "subject",
        "detail"
      ]
    }
  }
}
